# Local data
MIXO_DATA_DIR=./data

# Shared Build Games LLM (prefer; never commit real key)
BUILD_GAMES_LLM_API_KEY=

# OpenAI-compatible (used when BUILD_GAMES key is not xai-)
# For Z.AI: OPENAI_BASE_URL=https://api.z.ai/api/paas/v4
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# Optional xAI / Grok
XAI_API_KEY=
GROK_API_KEY=
XAI_MODEL=grok-4.6

# Optional Anthropic-compatible (e.g. Z.AI anthropic path)
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=glm-5.3

# Force sql.js (Vercel path) locally
# USE_SQLJS=1
